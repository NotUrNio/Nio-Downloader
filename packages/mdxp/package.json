{
  "name": "@niodownloader/mdxp",
  "version": "0.8.1",
  "description": "Nio Downloader Download eXchange Protocol — JSON-RPC 2.0 wire types and connection helpers",
  "license": "MIT",
  "author": "NotUrNio",
  "homepage": "https://github.com/NotUrNio/Nio-Downloader#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NotUrNio/Nio-Downloader.git"
  },
  "keywords": [
    "niodownloader",
    "mdxp",
    "json-rpc",
    "jsonrpc",
    "download",
    "protocol",
    "websocket",
    "zod"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "default": "./dist/node.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "default": "./dist/browser.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/__tests__",
    "README.md",
    "README.zh-CN.md"
  ],
  "scripts": {
    "build": "node build.mjs",
    "prepare": "node build.mjs"
  },
  "dependencies": {
    "vscode-jsonrpc": "^9.0.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "typescript": "^5.8.2"
  }
}
