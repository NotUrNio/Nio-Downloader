[Desktop Entry]
Type=Application
Name=Nio Downloader
GenericName=Download Manager
Comment=Full-featured download manager
Categories=Network;FileTransfer;
Keywords=download;bittorrent;magnet;aria2;
Exec=start-niodownloader %U
Icon=app.niodownloader.native
Terminal=false
StartupNotify=true
StartupWMClass=Nio Downloader
MimeType=application/x-bittorrent;x-scheme-handler/magnet;x-scheme-handler/nio;
