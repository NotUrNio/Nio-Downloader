{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.nio.downloader",
  "productName": "Nio Downloader",
  "copyright": "Copyright © 2026 NotUrNio",
  "toolsets": {
    "appimage": "1.0.3"
  },
  "asar": true,
  "asarUnpack": [
    "**/node_modules/{better-sqlite3,bindings,file-uri-to-path}/**",
    "dist/renderer/**"
  ],
  "directories": {
    "app": "dist/electron-app",
    "output": "release",
    "buildResources": "build"
  },
  "files": [
    ".nio-package-stage.json",
    "dist/core/plugin/host/**",
    "dist/main/**",
    "dist/preload/**",
    "dist/renderer/**",
    "package.json",
    {
      "from": "node_modules",
      "to": "node_modules",
      "filter": [
        "**/*",
        "!**/*.map",
        "!**/*.ts",
        "!**/*.tsx",
        "!**/tsconfig*.json",
        "!**/biome.json",
        "!**/vite*.config.*"
      ]
    },
    "!**/*.map",
    "!**/*.ts",
    "!**/*.tsx",
    "!**/tsconfig*.json",
    "!**/biome.json",
    "!**/vite*.config.*"
  ],
  "extraResources": [
    {
      "from": "./THIRD_PARTY_NOTICES.md",
      "to": "./THIRD_PARTY_NOTICES.md"
    },
    {
      "from": "./THIRD_PARTY_LICENSES",
      "to": "./THIRD_PARTY_LICENSES"
    },
    {
      "from": "./build/legal",
      "to": "./legal",
      "filter": [
        "THIRD_PARTY_DEPENDENCIES.md",
        "THIRD_PARTY_LICENSES.txt",
        "sbom.spdx.json"
      ]
    }
  ],
  "electronFuses": {
    "runAsNode": false,
    "enableCookieEncryption": false,
    "enableNodeOptionsEnvironmentVariable": false,
    "enableNodeCliInspectArguments": false,
    "enableEmbeddedAsarIntegrityValidation": false,
    "onlyLoadAppFromAsar": true,
    "loadBrowserProcessSpecificV8Snapshot": false,
    "grantFileProtocolExtraPrivileges": true
  },
  "protocols": [
    {
      "name": "Nio Protocol",
      "schemes": ["nio"]
    },
    {
      "name": "Magnet Protocol",
      "schemes": ["magnet"]
    }
  ],
  "mac": {
    "icon": "build/icon.icns",
    "category": "public.app-category.utilities",
    "type": "distribution",
    "artifactName": "Nio-Downloader-${version}-${arch}.${ext}",
    "bundleShortVersion": "1.0.0",
    "bundleVersion": "1.0.0",
    "minimumSystemVersion": "13.0",
    "hardenedRuntime": true,
    "gatekeeperAssess": false,
    "entitlements": "build/entitlements.mac.plist",
    "entitlementsInherit": "build/entitlements.mac.plist",
    "darkModeSupport": true,
    "fileAssociations": [
      {
        "ext": "torrent",
        "mimeType": "application/x-bittorrent",
        "name": "Torrent",
        "role": "Viewer"
      }
    ],
    "extendInfo": {
      "NSAppleEventsUsageDescription": "Nio Downloader requests permission to shut down your Mac when all downloads finish, only when you enable this action.",
      "NSLocalNetworkUsageDescription": "Nio Downloader uses the local network for UPnP port mapping and discovering download peers."
    },
    "sign": "./scripts/sign-macos.mjs",
    "extraFiles": [
      {
        "from": "packages/safari-bootstrap/dist/darwin-${arch}/NioSafariBootstrap",
        "to": "Library/LaunchServices/NioSafariBootstrap"
      },
      {
        "from": "packages/safari-bootstrap/dist/darwin-${arch}/NioSafariRegistrar",
        "to": "MacOS/NioSafariRegistrar"
      },
      {
        "from": "build/app.niodownloader.safari.bootstrap.plist",
        "to": "Library/LaunchAgents/app.niodownloader.safari.bootstrap.plist"
      }
    ],
    "target": ["dmg", "zip"],
    "extraResources": [
      { "from": "./extra/aria2.conf", "to": "./extra/aria2.conf" },
      { "from": "./dist/builtin-plugins", "to": "./builtin-plugins" },
      { "from": "./extra/darwin/${arch}/", "to": "./extra/darwin/${arch}/" },
      {
        "from": "./packages/native-host/dist/darwin-${arch}/nio-native-host",
        "to": "bin/nio-native-host"
      },
      {
        "from": "./packages/finalize-fs/dist/darwin-${arch}/nio-finalize-fs",
        "to": "bin/nio-finalize-fs"
      },
      {
        "from": "./extra/tray/",
        "to": "./extra/tray/",
        "filter": [
          "nio-tray-dark-normal@1x.png",
          "nio-tray-dark-normal@2x.png",
          "tray.svg",
          "resvg.wasm",
          "SFNS-Regular.ttf"
        ]
      }
    ]
  },
  "dmg": {
    "window": { "width": 540, "height": 380 },
    "contents": [
      { "x": 410, "y": 230, "type": "link", "path": "/Applications" },
      { "x": 130, "y": 230, "type": "file" }
    ]
  },
  "win": {
    "icon": "build/icon.ico",
    "target": [
      { "target": "nsis", "arch": ["x64"] },
      { "target": "zip", "arch": ["x64"] }
    ],
    "artifactName": "Nio-Downloader-${version}-win.${ext}",
    "extraResources": [
      { "from": "./extra/aria2.conf", "to": "./extra/aria2.conf" },
      { "from": "./dist/builtin-plugins", "to": "./builtin-plugins" },
      { "from": "./extra/win32/${arch}/", "to": "./extra/win32/${arch}/" },
      {
        "from": "./packages/native-host/dist/win32-${arch}/nio-native-host.exe",
        "to": "bin/nio-native-host.exe"
      },
      {
        "from": "./packages/finalize-fs/dist/win32-${arch}/nio-finalize-fs.exe",
        "to": "bin/nio-finalize-fs.exe"
      },
      {
        "from": "./extra/tray/",
        "to": "./extra/tray/",
        "filter": ["nio-tray-colorful-*.ico"]
      }
    ]
  },
  "nsis": {
    "include": "build/installer.nsh",
    "artifactName": "Nio-Downloader-Setup-${version}.${ext}",
    "installerIcon": "build/icon.ico",
    "uninstallerIcon": "build/icon.ico",
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false,
    "perMachine": false
  },
  "linux": {
    "icon": "build/icons",
    "maintainer": "NotUrNio <185019436+NotUrNio@users.noreply.github.com>",
    "syncDesktopName": true,
    "executableName": "niodownloader",
    "category": "Network",
    "synopsis": "Full-featured download manager",
    "description": "Nio Downloader is a full-featured download manager that supports HTTP, FTP, BitTorrent and Magnet downloads.",
    "fileAssociations": [
      {
        "ext": "torrent",
        "mimeType": "application/x-bittorrent",
        "name": "Torrent",
        "role": "Viewer"
      }
    ],
    "mimeTypes": [
      "application/x-bittorrent",
      "x-scheme-handler/magnet",
      "x-scheme-handler/nio"
    ],
    "desktop": {
      "entry": {
        "Name": "Nio Downloader",
        "GenericName": "Download Manager",
        "Comment": "Full-featured download manager",
        "Keywords": "download;bittorrent;magnet;aria2;nio;",
        "MimeType": "application/x-bittorrent;x-scheme-handler/magnet;x-scheme-handler/nio;",
        "StartupWMClass": "Nio Downloader"
      }
    },
    "target": [
      { "target": "AppImage", "arch": ["x64", "arm64"] },
      { "target": "deb", "arch": ["x64", "arm64"] },
      { "target": "rpm", "arch": ["x64", "arm64"] },
      { "target": "pacman", "arch": ["x64", "arm64"] }
    ],
    "extraResources": [
      { "from": "./extra/aria2.conf", "to": "./extra/aria2.conf" },
      { "from": "./dist/builtin-plugins", "to": "./builtin-plugins" },
      {
        "from": "./build/256x256.png",
        "to": "./icons/nio-appimage-256.png"
      },
      { "from": "./extra/linux/${arch}/", "to": "./extra/linux/${arch}/" },
      {
        "from": "./packages/native-host/dist/linux-${arch}/nio-native-host",
        "to": "bin/nio-native-host"
      },
      {
        "from": "./packages/finalize-fs/dist/linux-${arch}/nio-finalize-fs",
        "to": "bin/nio-finalize-fs"
      },
      {
        "from": "./extra/tray/",
        "to": "./extra/tray/",
        "filter": [
          "nio-tray-dark-normal@1x.png",
          "nio-tray-dark-normal@2x.png",
          "nio-tray-dark-active@1x.png",
          "nio-tray-dark-active@2x.png",
          "nio-tray-light-normal@1x.png",
          "nio-tray-light-normal@2x.png",
          "nio-tray-light-active@1x.png",
          "nio-tray-light-active@2x.png"
        ]
      }
    ]
  },
  "appImage": {
    "artifactName": "Nio-Downloader-${version}-${arch}.${ext}"
  },
  "deb": {
    "artifactName": "Nio-Downloader_${version}_${arch}.${ext}"
  },
  "rpm": {
    "artifactName": "Nio-Downloader-${version}.${arch}.${ext}"
  },
  "pacman": {
    "artifactName": "Nio-Downloader-${version}-${arch}.${ext}",
    "packageName": "niodownloader",
    "compression": "zstd",
    "depends": [
      "alsa-lib",
      "at-spi2-core",
      "cairo",
      "expat",
      "gcc-libs",
      "glib2",
      "glibc",
      "gtk3",
      "libcups",
      "libdrm",
      "libnotify",
      "libsecret",
      "libx11",
      "libxcb",
      "libxcomposite",
      "libxdamage",
      "libxext",
      "libxfixes",
      "libxkbcommon",
      "libxrandr",
      "mesa",
      "nspr",
      "nss",
      "pango",
      "xdg-utils"
    ],
    "fpm": [
      "--description",
      "Full-featured download manager",
      "--iteration",
      "1",
      "--provides",
      "niodownloader",
      "--conflicts",
      "niodownloader-bin",
      "--conflicts",
      "niodownloader-git",
      "--conflicts",
      "niodownloader-beta-bin",
      "--pacman-optional-depends",
      "libayatana-appindicator: system tray integration"
    ]
  },
  "beforePack": "./scripts/before-pack-verify.mjs",
  "beforeBuild": "./scripts/before-build-use-staged-dependencies.mjs",
  "artifactBuildCompleted": "./scripts/finalize-appimage-artifact.mjs",
  "detectUpdateChannel": true,
  "generateUpdatesFilesForAllChannels": true,
  "publish": {
    "provider": "github",
    "owner": "NotUrNio",
    "repo": "Nio-Downloader"
  }
}
