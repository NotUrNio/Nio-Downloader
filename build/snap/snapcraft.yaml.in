name: nio-downloader
title: Nio Downloader
summary: Full-featured download manager
description: |
  Nio Downloader is a full-featured download manager that supports HTTP, FTP,
  BitTorrent, Magnet, and Metalink downloads.
license: MIT
website: https://niodownloader.com
source-code: https://github.com/NotUrNio/Nio-Downloader
issues: https://github.com/NotUrNio/Nio-Downloader/issues
version: '@NIODOWNLOADER_VERSION@'
base: core24
grade: stable
confinement: strict
assumes:
  - snapd2.46

platforms:
  @SNAP_ARCH@:
    build-on:
      - @SNAP_ARCH@
    build-for:
      - @SNAP_ARCH@

plugs:
  browser-support:
    interface: browser-support
    allow-sandbox: false
  browser-native-messaging:
    interface: personal-files
    write:
      - $HOME/.config/google-chrome/NativeMessagingHosts/app.niodownloader.bridge.json
      - $HOME/.config/microsoft-edge/NativeMessagingHosts/app.niodownloader.bridge.json
      - $HOME/.mozilla/native-messaging-hosts/app.niodownloader.bridge.json

apps:
  nio-downloader:
    command: app/nio-downloader --no-sandbox
    extensions:
      - gnome
    environment:
      NIODOWNLOADER_BRIDGE_DATA_DIR: $SNAP_USER_COMMON/bridge
      TMPDIR: $XDG_RUNTIME_DIR
    plugs:
      - audio-playback
      - browser-native-messaging
      - browser-support
      - home
      - network
      - network-bind
      - removable-media
      - screen-inhibit-control
      - unity7
  native-host:
    command: app/resources/bin/nio-native-host
    environment:
      NIODOWNLOADER_BRIDGE_DATA_DIR: $SNAP_USER_COMMON/bridge
    plugs:
      - desktop
      - network

parts:
  nio-downloader:
    plugin: nil
    source: app
    override-build: |
      craftctl default
      mkdir -p "$CRAFT_PART_INSTALL/app"
      cp --archive "$CRAFT_PART_SRC"/. "$CRAFT_PART_INSTALL/app/"
    stage-packages:
      - libayatana-appindicator3-1
      - libnspr4
      - libnss3
      - libnotify4
      - libsecret-1-0
      - libxss1
      - util-linux
    prime:
      - -app/chrome-sandbox
